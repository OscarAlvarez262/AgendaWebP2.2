        <span class="kw1">ON</span> <span class="kw1">DELETE</span> <span class="kw1">RESTRICT</span>
<span class="br0">&#41;</span> ENGINE<span class="sy0">=</span>InnoDB <span class="kw1">DEFAULT</span> CHARSET<span class="sy0">=</span>utf8mb4;