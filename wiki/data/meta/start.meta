AgendaWeb es una aplicación web en PHP + MySQL/MariaDB para registrar y consultar eventos personales. Cada usuario crea su cuenta, inicia sesión y gestiona solo sus propios eventos (título, fecha, hora, categoría, prioridad y descripción), con búsqueda por título y control de acceso por sesión.";}s:8:"relation";a:2:{s:10:"references";a:4:{s:19:"wikis:investigacion";b:1;s:21:"agendaweb:instalacion";b:1;s:23:"agendaweb:base_de_datos";b:1;s:17:"agendaweb:paginas";b:1;}s:10:"firstimage";s:0:"";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}}s:10:"persistent";a:5:{s:4:"date";a:2:{s:7:"created";i:1793715700;s:8:"modified";i:1793715954;}s:7:"creator";s:30:"Oscar Alejandro Alvarez Aceves";s:4:"user";s:10:"adminoscar";s:11:"last_change";b:0;s:11:"contributor";a:1:{s:10:"adminoscar";s:30:"Oscar Alejandro Alvarez Aceves";}}}